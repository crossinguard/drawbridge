{
  "$schema": "https://starwind.dev/config-schema.v2.json",
  "version": 2,
  "framework": "astro",
  "registry": {
    "source": "bundled",
    "version": "2.2.0"
  },
  "pro": {
    "registry": {
      "headers": {
        "Authorization": "Bearer ${STARWIND_LICENSE_KEY}"
      }
    }
  },
  "components": [
    {
      "name": "button",
      "version": "3.0.2",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "card",
      "version": "2.3.1",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "input",
      "version": "2.0.2",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "textarea",
      "version": "1.4.0",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "label",
      "version": "1.3.0",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "table",
      "version": "1.2.1",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "tabs",
      "version": "2.1.0",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "alert",
      "version": "1.4.1",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "toast",
      "version": "2.1.1",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "native-select",
      "version": "1.1.1",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "badge",
      "version": "1.5.0",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "separator",
      "version": "1.1.0",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "sheet",
      "version": "2.0.3",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "collapsible",
      "version": "2.0.2",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "scroll-area",
      "version": "2.1.0",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "tooltip",
      "version": "2.2.1",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "accordion",
      "version": "2.0.4",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "prose",
      "version": "1.1.1",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "breadcrumb",
      "version": "1.2.1",
      "framework": "astro",
      "registry": "default"
    }
  ],
  "tailwind": {
    "css": "src/styles/starwind.css",
    "baseColor": "neutral",
    "cssVariables": true
  },
  "componentDir": "src/components/starwind",
  "utilsDir": "src/lib/utils"
}
