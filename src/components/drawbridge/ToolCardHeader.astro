---
import { CardDescription, CardHeader, CardTitle } from "@/components/starwind/card";
import ToolStatusBadge from "@/components/drawbridge/ToolStatusBadge.astro";
import type { ToolStatus } from "@/lib/tools/registry";

interface Props {
  /** Icon component shown at the top of the card. */
  icon: any;
  /** Status of the tool the card describes. */
  status: ToolStatus;
  /** Title of the card. */
  title: string;
  /** Where the title links to. Omit for a non-clickable title. */
  href?: string;
  /** Supporting copy under the title. */
  description?: string;
  /** Size of the icon. */
  iconClass?: string;
}

const { icon: Icon, status, title, href, description, iconClass = "size-8" } = Astro.props;

const muted = status === "planned";
---

<CardHeader>
  <div class="mb-2 flex items-start justify-between gap-2">
    <div class={muted ? "text-muted-foreground" : "text-primary"}>
      <Icon class={iconClass} aria-hidden="true" />
    </div>
    <ToolStatusBadge status={status} />
  </div>
  <CardTitle>
    {href ? (
      <a href={href} class="hover:underline underline-offset-4">
        {title}
      </a>
    ) : (
      title
    )}
  </CardTitle>
  {description && <CardDescription>{description}</CardDescription>}
</CardHeader>
