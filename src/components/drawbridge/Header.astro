---
import Menu from "@tabler/icons/outline/menu.svg";

import { Button } from "@/components/starwind/button";
import {
  Sheet,
  SheetContent,
  SheetDescription,
  SheetHeader,
  SheetTitle,
  SheetTrigger,
} from "@/components/starwind/sheet";
import { ThemeToggle } from "@/components/starwind/theme-toggle";

const links = [
  { href: "/tools", label: "Tools" },
  { href: "/guides", label: "Guides" },
  { href: "/about", label: "About" },
  { href: "/privacy", label: "Privacy" },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-border bg-background">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-4">
    <a
      href="/"
      aria-label="Drawbridge home"
      class="font-heading text-2xl leading-none text-foreground hover:opacity-80 transition-opacity"
    >
      Drawbridge
    </a>

    <div class="flex items-center gap-2">
      <nav aria-label="Primary" class="hidden items-center gap-1 text-sm md:flex">
        {
          links.map((link) => {
            const active = currentPath === link.href || currentPath.startsWith(`${link.href}/`);
            return (
              <a
                href={link.href}
                aria-current={active ? "page" : undefined}
                class={[
                  "rounded-md px-3 py-2 transition-colors hover:bg-muted hover:text-foreground",
                  active ? "bg-muted text-foreground font-medium" : "text-muted-foreground",
                ].join(" ")}
              >
                {link.label}
              </a>
            );
          })
        }
      </nav>

      <ThemeToggle />

      <Sheet>
        <SheetTrigger asChild>
          <Button variant="outline" size="icon" class="md:hidden" aria-label="Open navigation menu">
            <Menu class="size-5" aria-hidden="true" />
          </Button>
        </SheetTrigger>
        <SheetContent side="right">
          <SheetHeader>
            <SheetTitle>Menu</SheetTitle>
            <SheetDescription class="sr-only">Site navigation links</SheetDescription>
          </SheetHeader>
          <nav aria-label="Mobile" class="grid gap-1 py-6">
            {
              links.map((link) => {
                const active = currentPath === link.href || currentPath.startsWith(`${link.href}/`);
                return (
                  <a
                    href={link.href}
                    aria-current={active ? "page" : undefined}
                    class={[
                      "rounded-md px-3 py-3 text-base font-medium transition-colors hover:bg-muted",
                      active ? "bg-muted text-foreground" : "text-foreground",
                    ].join(" ")}
                  >
                    {link.label}
                  </a>
                );
              })
            }
          </nav>
        </SheetContent>
      </Sheet>
    </div>
  </div>
</header>
