---
import Menu from "@tabler/icons/outline/menu.svg";

import { Button } from "@/components/starwind/button";
import {
  Sheet,
  SheetContent,
  SheetDescription,
  SheetHeader,
  SheetTitle,
  SheetTrigger,
} from "@/components/starwind/sheet";
import NavLink from "@/components/drawbridge/NavLink.astro";
import { NAV_LINKS, isActiveLink } from "@/lib/nav";

const currentPath = Astro.url.pathname;
---

<header class="border-b border-border bg-background">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-4">
    <a
      href="/"
      aria-label="Drawbridge home"
      class="font-heading text-2xl leading-none text-foreground transition-opacity hover:opacity-80"
    >
      Drawbridge
    </a>

    <div class="flex items-center gap-2">
      <nav aria-label="Primary" class="hidden items-center gap-1 text-sm md:flex">
        {NAV_LINKS.map((link) => (
          <NavLink href={link.href} label={link.label} active={isActiveLink(currentPath, link.href)} size="sm" />
        ))}
      </nav>

      <Sheet>
        <SheetTrigger asChild>
          <Button variant="outline" size="icon" class="md:hidden" aria-label="Open navigation menu">
            <Menu class="size-5" aria-hidden="true" />
          </Button>
        </SheetTrigger>
        <SheetContent side="right">
          <SheetHeader>
            <SheetTitle>Menu</SheetTitle>
            <SheetDescription class="sr-only">Site navigation links</SheetDescription>
          </SheetHeader>
          <nav aria-label="Mobile" class="grid gap-1 py-6">
            {NAV_LINKS.map((link) => (
              <NavLink href={link.href} label={link.label} active={isActiveLink(currentPath, link.href)} size="md" />
            ))}
          </nav>
        </SheetContent>
      </Sheet>
    </div>
  </div>
</header>
