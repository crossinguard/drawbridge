---
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";
import Book from "@tabler/icons/outline/book.svg";

import { Card, CardContent } from "@/components/starwind/card";
import ToolCardHeader from "@/components/drawbridge/ToolCardHeader.astro";
import type { ToolEntry } from "@/lib/tools/registry";

interface Props {
  tool: ToolEntry;
}

const { tool } = Astro.props;

const { icon: Icon } = tool;
const isPlanned = tool.status === "planned";
---

<Card class="flex h-full flex-col text-left transition-shadow hover:shadow-sm">
  <ToolCardHeader icon={Icon} status={tool.status} title={tool.title} href={tool.href} description={tool.description} />

  <CardContent class="mt-auto grid gap-3">
    {isPlanned ? (
      <p class="text-sm text-muted-foreground">Nothing here yet — this is an idea for a future tool.</p>
    ) : (
      <>
        <a
          href={tool.href}
          class="inline-flex items-center justify-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary-accent"
        >
          Open tool
          <ArrowRight class="size-4" aria-hidden="true" />
        </a>
        {tool.guideHref && (
          <a
            href={tool.guideHref}
            class="inline-flex items-center justify-center gap-2 text-sm text-muted-foreground hover:text-foreground"
          >
            <Book class="size-4" aria-hidden="true" />
            Guide
          </a>
        )}
      </>
    )}
  </CardContent>
</Card>
