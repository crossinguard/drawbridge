---
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";
import Book from "@tabler/icons/outline/book.svg";

import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/starwind/card";
import ToolStatusBadge from "@/components/drawbridge/ToolStatusBadge.astro";
import type { ToolEntry } from "@/lib/tools/registry";

interface Props {
  tool: ToolEntry;
}

const { tool } = Astro.props;

const { icon: Icon } = tool;
const isPlanned = tool.status === "planned";
---

<Card class="flex h-full flex-col text-left transition-shadow hover:shadow-sm">
  <CardHeader>
    <div class="mb-2 flex items-start justify-between gap-2">
      <div class={isPlanned ? "text-muted-foreground" : "text-primary"}>
        <Icon class="size-8" aria-hidden="true" />
      </div>
      <ToolStatusBadge status={tool.status} />
    </div>
    <CardTitle>
      {tool.href ? (
        <a href={tool.href} class="hover:underline underline-offset-4">
          {tool.title}
        </a>
      ) : (
        tool.title
      )}
    </CardTitle>
    <CardDescription>{tool.description}</CardDescription>
  </CardHeader>

  <CardContent class="mt-auto grid gap-3">
    {isPlanned ? (
      <p class="text-muted-foreground text-sm">Nothing here yet — this is an idea for a future tool.</p>
    ) : (
      <>
        <a
          href={tool.href}
          class="inline-flex items-center justify-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary-accent"
        >
          Open tool
          <ArrowRight class="size-4" aria-hidden="true" />
        </a>
        {tool.guideHref && (
          <a
            href={tool.guideHref}
            class="text-muted-foreground inline-flex items-center justify-center gap-2 text-sm hover:text-foreground"
          >
            <Book class="size-4" aria-hidden="true" />
            Guide
          </a>
        )}
      </>
    )}
  </CardContent>
</Card>
