---
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";
import Book from "@tabler/icons/outline/book.svg";
import { Button } from "@/components/starwind/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/starwind/card";
import type { ToolEntry } from "@/lib/tools/registry";

interface Props {
  tool: ToolEntry;
}

const { tool } = Astro.props;
const { icon: Icon } = tool;
---

<Card class="flex h-full flex-col text-left transition-shadow hover:shadow-sm">
  <CardHeader>
    <div class="mb-3 flex size-11 items-center justify-center rounded-lg bg-secondary text-secondary-foreground">
      <Icon class="size-6" aria-hidden="true" />
    </div>
    <p class="text-xs font-medium tracking-wide text-secondary-accent uppercase">{tool.sourceLabel}</p>
    <CardTitle class="text-xl">{tool.title}</CardTitle>
    <CardDescription>{tool.description}</CardDescription>
  </CardHeader>
  <CardContent class="mt-auto flex flex-wrap items-center gap-2">
    <Button as="a" href={tool.href}>
      Open tool
      <ArrowRight class="size-4" aria-hidden="true" />
    </Button>
    <Button as="a" href={tool.guideHref} variant="ghost">
      <Book class="size-4" aria-hidden="true" />
      Read the guide
    </Button>
  </CardContent>
</Card>
