---
import ToolStatusBadge from "@/components/drawbridge/ToolStatusBadge.astro";
import { TOOL_STATUS_META, type ToolStatus } from "@/lib/tools/registry";

interface Props {
  status: ToolStatus;
}

const { status } = Astro.props;

const meta = TOOL_STATUS_META[status];
---

<p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
  <ToolStatusBadge status={status} size="md" />
  <span class="text-muted-foreground">{meta.description}</span>
</p>
