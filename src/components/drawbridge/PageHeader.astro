---
interface Props {
  level?: "h1" | "h2";
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { level = "h1", title, description, align = "center" } = Astro.props;
const Heading = level;
---

<div class:list={["grid gap-2", align === "center" ? "text-center" : "text-left"]}>
  <Heading class={level === "h1" ? "page-title" : "section-title"}>{title}</Heading>
  {description && <p class="supporting-text">{description}</p>}
</div>
