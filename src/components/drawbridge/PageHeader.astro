---
interface Props {
  /** Heading level for the page title. */
  level?: "h1" | "h2";
  /** The title text. */
  title: string;
  /** Supporting copy under the title. */
  description?: string;
}

const { level = "h1", title, description } = Astro.props;

const Heading = level;
---

<div class="grid gap-2 text-center">
  <Heading class="text-2xl font-bold tracking-tight sm:text-3xl">{title}</Heading>
  {description && <p class="text-muted-foreground">{description}</p>}
</div>
