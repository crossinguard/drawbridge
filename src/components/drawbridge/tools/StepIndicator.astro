---
import ChevronRight from "@tabler/icons/outline/chevron-right.svg";

import { stepSectionId, type ToolStep } from "@/lib/tools/steps";

interface Props {
  steps: ToolStep[];
}

const { steps } = Astro.props;
---

<ol class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm" aria-label="Progress">
  {steps.map((step, index) => (
    <li
      id={`step-${index + 1}`}
      class="group flex items-center gap-2"
      data-step={index + 1}
      data-section={stepSectionId(step.id)}
    >
      <button
        type="button"
        data-step-action={index + 1}
        class="flex items-center gap-2 rounded-md p-1 transition-colors hover:bg-muted disabled:pointer-events-none"
        disabled={index > 0}
      >
        <span data-step-badge class="flex size-6 items-center justify-center rounded-full text-xs font-medium">
          {index + 1}
        </span>
        <span data-step-label>{step.label}</span>
      </button>
      {index < steps.length - 1 && <ChevronRight class="size-4 text-muted-foreground/60" aria-hidden="true" />}
    </li>
  ))}
</ol>
