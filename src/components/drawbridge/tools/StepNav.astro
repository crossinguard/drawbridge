---
import { Button } from "@/components/starwind/button";
import { CardFooter } from "@/components/starwind/card";

interface Props {
  /** Label of the button that returns to the previous step. */
  backLabel?: string;
  /** Label of the button that advances to the next step. */
  nextLabel?: string;
}

const { backLabel = "Back", nextLabel = "Continue to export" } = Astro.props;
---

<CardFooter class="justify-between">
  <Button variant="ghost" data-step-nav="back">
    {backLabel}
  </Button>
  <slot name="actions">
    <Button data-step-nav="next">{nextLabel}</Button>
  </slot>
</CardFooter>
