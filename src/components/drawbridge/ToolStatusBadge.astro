---
import { badge as badgeClasses } from "@/components/starwind/badge/variants";
import { TOOL_STATUS_META, type ToolStatus } from "@/lib/tools/registry";
import { cn } from "@/lib/utils";

interface Props {
  status: ToolStatus;
  size?: "sm" | "md" | "lg";
  class?: string;
}

const { status, size = "sm", class: className } = Astro.props;

const meta = TOOL_STATUS_META[status];
---

<span
  class={badgeClasses({
    variant: meta.badgeVariant,
    size,
    // `font-sans` keeps the badge out of the heading font when it is placed
    // inside a heading; `w-fit` stops it stretching inside a grid cell.
    // `cn` merges the caller's classes last so they win over the base.
    class: cn("w-fit font-sans", className),
  })}
>
  {meta.label}
</span>
