---
import type { PaletteDefinition } from "@/lib/design/catalog";
import ColorSwatch from "./ColorSwatch.astro";

interface Props {
  palette: PaletteDefinition;
}

const { palette } = Astro.props;
---

<article class="grid gap-4 rounded-lg border border-border bg-card p-4" aria-labelledby={`palette-${palette.token}`}>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h3 id={`palette-${palette.token}`} class="font-heading text-xl">
        {palette.name}
      </h3>
      <code class="font-mono text-xs text-muted-foreground">--color-{palette.token}-*</code>
    </div>
    <div class="w-full sm:w-32">
      <ColorSwatch label="Brand base" token={`--color-${palette.token}`} swatchClass={palette.baseClass} compact />
    </div>
  </div>

  <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 md:grid-cols-6 xl:grid-cols-11">
    {palette.shades.map((shade) => (
      <ColorSwatch
        label={shade.shade}
        token={`--color-${palette.token}-${shade.shade}`}
        swatchClass={shade.class}
        compact
      />
    ))}
  </div>
</article>
