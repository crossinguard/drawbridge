---
import { Button } from "@/components/starwind/button";
---

<aside
  data-pwa-update
  role="status"
  class="fixed inset-x-4 bottom-4 z-50 mx-auto hidden max-w-lg rounded-lg border border-border bg-card p-4 text-card-foreground shadow-lg"
  aria-label="Drawbridge update"
>
  <div class="grid gap-3">
    <div class="grid gap-1">
      <h2 class="font-semibold">A new version is ready</h2>
      <p class="text-sm text-muted-foreground">Reload to use it. You will need to reopen any course in this session.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <Button type="button" data-pwa-reload size="sm">
        Reload Drawbridge
      </Button>
      <Button type="button" data-pwa-dismiss variant="ghost" size="sm">
        Not now
      </Button>
    </div>
  </div>
</aside>
