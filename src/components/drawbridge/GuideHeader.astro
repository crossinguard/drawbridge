---
import ChevronRight from "@tabler/icons/outline/chevron-right.svg";

interface Props {
  toolName: string;
  toolSlug: string;
  description?: string;
}

const { toolName, toolSlug, description } = Astro.props;

const toolHref = `/tools/${toolSlug}`;
---

<div class="mx-auto grid max-w-3xl gap-4">
  <nav aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
      <li>
        <a href="/tools" class="hover:text-foreground hover:underline underline-offset-4">Tools</a>
      </li>
      <li>
        <ChevronRight class="size-4" aria-hidden="true" />
      </li>
      <li>
        <a href={toolHref} class="hover:text-foreground hover:underline underline-offset-4">{toolName}</a>
      </li>
      <li>
        <ChevronRight class="size-4" aria-hidden="true" />
      </li>
      <li class="font-medium text-foreground" aria-current="page">Reference</li>
    </ol>
  </nav>

  <div class="grid gap-2">
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">{toolName}: Reference</h1>
    {description && <p class="text-muted-foreground">{description}</p>}
  </div>
</div>
