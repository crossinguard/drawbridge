---
import DrawbridgeLayout from "@/layouts/DrawbridgeLayout.astro";
import ShieldLock from "@tabler/icons/outline/shield-lock.svg";
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";
import FileTypeCsv from "@tabler/icons/outline/file-type-csv.svg";
import GitCompare from "@tabler/icons/outline/git-compare.svg";
import Book from "@tabler/icons/outline/book.svg";

import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/starwind/card";
import { Badge } from "@/components/starwind/badge";

const tools = [
  {
    href: "/tools/rubric-csv",
    icon: FileTypeCsv,
    title: "Rubric → Canvas CSV",
    description: "Convert a Word rubric table into a Canvas import CSV.",
    guideHref: "/guides/rubric-csv",
  },
  {
    href: "/tools/outcome-mapper",
    icon: GitCompare,
    title: "Outcome Mapper",
    description: "Map program, course, and assessment outcomes and export the alignment table.",
    guideHref: "/guides/outcome-mapper",
  },
];
---

<DrawbridgeLayout
  title="Drawbridge"
  description="Free, private tools for assessment work. No login, no tracking — everything stays on your device."
>
  <div class="mx-auto grid max-w-3xl gap-8 text-center">
    <section class="grid gap-4">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Drawbridge</h1>
      <p class="text-muted-foreground mx-auto max-w-2xl text-lg">
        Free, private tools for assessment work. No login, no fee, no tracking — everything stays on your device.
      </p>
      <div class="flex justify-center">
        <Badge variant="secondary">
          <ShieldLock class="size-4 text-primary" aria-hidden="true" />
          100% local
        </Badge>
      </div>
    </section>

    <section class="grid gap-4 sm:grid-cols-2">
      {
        tools.map((tool) => (
          <Card class="flex flex-col text-left transition-shadow hover:shadow-sm">
            <CardHeader>
              <div class="text-primary mb-2">
                <tool.icon class="size-8" aria-hidden="true" />
              </div>
              <CardTitle>
                <a href={tool.href} class="hover:underline underline-offset-4">
                  {tool.title}
                </a>
              </CardTitle>
              <CardDescription>{tool.description}</CardDescription>
            </CardHeader>
            <CardContent class="mt-auto grid gap-3">
              <a
                href={tool.href}
                class="inline-flex items-center justify-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary-accent"
              >
                Open tool
                <ArrowRight class="size-4" aria-hidden="true" />
              </a>
              <a
                href={tool.guideHref}
                class="text-muted-foreground inline-flex items-center justify-center gap-2 text-sm hover:text-foreground"
              >
                <Book class="size-4" aria-hidden="true" />
                Guide
              </a>
            </CardContent>
          </Card>
        ))
      }
    </section>

    <section class="rounded-lg border border-border bg-muted/30 p-6 text-left">
      <h2 class="text-lg font-semibold text-foreground">Privacy first</h2>
      <p class="mt-2 text-muted-foreground text-sm">
        Drawbridge has no server, no analytics, and no persistence. Files and pasted content are processed in your
        browser and never transmitted. Once loaded, the site works fully offline and can be installed as an app.
      </p>
      <div class="mt-4">
        <a
          href="/privacy"
          class="text-primary text-sm font-medium underline underline-offset-4 hover:text-primary-accent"
        >
          Read the privacy details
        </a>
      </div>
    </section>
  </div>
</DrawbridgeLayout>
