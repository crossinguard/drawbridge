---
import DrawbridgeLayout from "@/layouts/DrawbridgeLayout.astro";

import drawbridgeLogo from "@/assets/branding/drawbridge-logo.svg";
import drawbridgeLogoDark from "@/assets/branding/drawbridge-logo-dark.svg";

import LocalBadge from "@/components/drawbridge/tools/LocalBadge.astro";
import PageHeader from "@/components/drawbridge/PageHeader.astro";
import ToolDirectory from "@/components/drawbridge/ToolDirectory.astro";
---

<DrawbridgeLayout
  title="Drawbridge"
  description="Free, private tools for assessment work. No login, no tracking — everything stays on your device."
>
  <div class="mx-auto grid max-w-3xl gap-8 text-center">
    <section class="grid gap-4">
      <h1>
        <img src={drawbridgeLogo.src} alt="Drawbridge" class="mx-auto h-24 w-auto sm:h-32 dark:hidden" />
        <img src={drawbridgeLogoDark.src} alt="Drawbridge" class="mx-auto hidden h-24 w-auto sm:h-32 dark:block" />
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-muted-foreground">
        Free, private tools for assessment work. No login, no fee, no tracking — everything stays on your device.
      </p>
      <div class="flex justify-center">
        <LocalBadge />
      </div>
    </section>

    <section id="tools" class="grid gap-6 scroll-mt-8 text-left">
      <PageHeader
        level="h2"
        title="Tools"
        description="Each tool runs in your browser. No data leaves your device. Tools are grouped by how finished they are."
      />

      <ToolDirectory />
    </section>

    <section class="rounded-lg border border-border bg-muted/30 p-6 text-left">
      <h2 class="text-lg font-semibold text-foreground">Privacy first</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        Drawbridge has no server, no analytics, and no persistence. Files and pasted content are processed in your
        browser and never transmitted. Once loaded, the site works fully offline and can be installed as an app.
      </p>
      <div class="mt-4">
        <a
          href="/privacy"
          class="text-sm font-medium text-primary underline underline-offset-4 hover:text-primary-accent"
        >
          Read the privacy details
        </a>
      </div>
    </section>
  </div>
</DrawbridgeLayout>
