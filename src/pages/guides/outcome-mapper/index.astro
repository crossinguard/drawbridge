---
import DrawbridgeLayout from "@/layouts/DrawbridgeLayout.astro";
import Book from "@tabler/icons/outline/book.svg";

import GuideContent from "@/components/drawbridge/GuideContent.astro";
import GuideHeader from "@/components/drawbridge/GuideHeader.astro";
import { Button } from "@/components/starwind/button";

import ReferenceContent from "@/content/guides/outcome-mapper.mdx";
---

<DrawbridgeLayout title="Outcome Mapper reference" description="Detailed reference for the Outcome Mapper tool.">
  <article class="mx-auto grid max-w-3xl gap-8">
    <GuideHeader
      toolName="Outcome Mapper"
      toolSlug="outcome-mapper"
      description="Input format, mapping rules, and export options."
    />

    <GuideContent>
      <ReferenceContent />
    </GuideContent>

    <div>
      <Button as="a" href="/tools/outcome-mapper" variant="outline" class="inline-flex items-center gap-2">
        <Book class="size-4" aria-hidden="true" />
        Back to tool
      </Button>
    </div>
  </article>
</DrawbridgeLayout>
