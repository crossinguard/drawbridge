---
import DrawbridgeLayout from "@/layouts/DrawbridgeLayout.astro";
import Book from "@tabler/icons/outline/book.svg";

import GuideContent from "@/components/drawbridge/GuideContent.astro";
import GuideHeader from "@/components/drawbridge/GuideHeader.astro";
import { Button } from "@/components/starwind/button";

import ReferenceContent from "@/content/guides/rubric-csv.mdx";
---

<DrawbridgeLayout
  title="Rubric → Canvas CSV reference"
  description="Detailed reference for the Rubric → Canvas CSV tool."
>
  <article class="mx-auto grid max-w-3xl gap-8">
    <GuideHeader
      toolName="Rubric → Canvas CSV"
      toolSlug="rubric-csv"
      description="Input formats, points presets, edge cases, and CSV output details."
    />

    <GuideContent>
      <ReferenceContent />
    </GuideContent>

    <div>
      <Button as="a" href="/tools/rubric-csv" variant="outline" class="inline-flex items-center gap-2">
        <Book class="size-4" aria-hidden="true" />
        Back to tool
      </Button>
    </div>
  </article>
</DrawbridgeLayout>
