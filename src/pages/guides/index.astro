---
import { getCollection } from "astro:content";
import DrawbridgeLayout from "@/layouts/DrawbridgeLayout.astro";
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";
import Book from "@tabler/icons/outline/book.svg";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/starwind/card";
import { getToolBySlug } from "@/lib/tools/registry";

const guides = await getCollection("guides");
---

<DrawbridgeLayout title="Guides" description="Plain-language guides for every Drawbridge tool.">
  <div class="mx-auto grid max-w-3xl gap-6">
    <div class="grid gap-2">
      <h1 class="page-title">Guides</h1>
      <p class="lede">Practical help for opening a file, using a tool, and understanding what you see.</p>
    </div>

    <section class="grid gap-4 sm:grid-cols-2" aria-label="Tool guides">
      {guides.map((guide) => {
        const tool = getToolBySlug(guide.data.toolSlug);
        if (!tool) return null;

        return (
          <Card class="flex flex-col text-left transition-shadow hover:shadow-sm">
            <CardHeader>
              <Book class="mb-3 size-7 text-primary" aria-hidden="true" />
              <CardTitle>
                <a href={`/guides/${tool.slug}`} class="underline-offset-4 hover:underline">
                  {tool.title}
                </a>
              </CardTitle>
              <CardDescription>{guide.data.description}</CardDescription>
            </CardHeader>
            <CardContent class="mt-auto">
              <a
                href={`/guides/${tool.slug}`}
                class="inline-flex items-center gap-1 text-sm font-medium text-primary underline-offset-4 hover:underline"
              >
                Read the guide
                <ArrowRight class="size-4" aria-hidden="true" />
              </a>
            </CardContent>
          </Card>
        );
      })}
    </section>
  </div>
</DrawbridgeLayout>
