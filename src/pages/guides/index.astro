---
import DrawbridgeLayout from "@/layouts/DrawbridgeLayout.astro";
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";
import Book from "@tabler/icons/outline/book.svg";

import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/starwind/card";
import ToolStatusBadge from "@/components/drawbridge/ToolStatusBadge.astro";
import { TOOLS } from "@/lib/tools/registry";

const guides = TOOLS.filter((tool) => tool.guideHref && tool.guideDescription);
---

<DrawbridgeLayout title="Guides" description="User guides for Drawbridge tools.">
  <div class="mx-auto grid max-w-3xl gap-6">
    <div class="grid gap-2 text-center">
      <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Guides</h1>
      <p class="text-muted-foreground">Reference documentation for each tool.</p>
    </div>

    <section class="grid gap-4 sm:grid-cols-2">
      {guides.map((guide) => (
        <Card class="flex flex-col text-left transition-shadow hover:shadow-sm">
          <CardHeader>
            <div class="mb-2 flex items-start justify-between gap-2">
              <div class="text-primary">
                <Book class="size-7" aria-hidden="true" />
              </div>
              <ToolStatusBadge status={guide.status} />
            </div>
            <CardTitle>
              <a href={guide.guideHref} class="hover:underline underline-offset-4">
                {guide.title}
              </a>
            </CardTitle>
            <CardDescription>{guide.guideDescription}</CardDescription>
          </CardHeader>
          <CardContent class="mt-auto">
            <a
              href={guide.guideHref}
              class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline underline-offset-4"
            >
              View guide
              <ArrowRight class="size-4" aria-hidden="true" />
            </a>
          </CardContent>
        </Card>
      ))}
    </section>
  </div>
</DrawbridgeLayout>
