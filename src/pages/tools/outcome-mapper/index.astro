---
import { getEntry, render } from "astro:content";

import ClipboardText from "@tabler/icons/outline/clipboard-text.svg";
import Download from "@tabler/icons/outline/download.svg";

import { Button } from "@/components/starwind/button";
import { Label } from "@/components/starwind/label";
import { Textarea } from "@/components/starwind/textarea";

import QuickStartCollapsible from "@/components/drawbridge/QuickStartCollapsible.astro";
import CodePreview from "@/components/drawbridge/tools/CodePreview.astro";
import LocalOnlyNotice from "@/components/drawbridge/tools/LocalOnlyNotice.astro";
import StatRow from "@/components/drawbridge/tools/StatRow.astro";
import StepNav from "@/components/drawbridge/tools/StepNav.astro";
import ToolLayout from "@/components/drawbridge/tools/ToolLayout.astro";
import ToolStep from "@/components/drawbridge/tools/ToolStep.astro";

import { requireToolBySlug } from "@/lib/tools/registry";
import { steps } from "@/lib/tools/outcome-mapper/steps";

const tool = requireToolBySlug("outcome-mapper");

const quickStartEntry = await getEntry("guides", "outcome-mapper-quick-start");
if (!quickStartEntry) throw new Error('Missing guide entry "outcome-mapper-quick-start".');
const { Content: QuickStartContent } = await render(quickStartEntry);
---

<ToolLayout tool={tool} steps={steps}>
  <QuickStartCollapsible slot="quick-start" toolSlug={tool.slug} description={quickStartEntry.data.description}>
    <QuickStartContent />
  </QuickStartCollapsible>

  <!-- Step 1: Import -->
  <ToolStep step={steps[0]} title="Import outcomes" hidden={false} class="gap-6">
    <Fragment slot="description">
      Paste a CSV or TSV list of outcomes. Each row needs a level (program, course, or assessment), an id, and the
      outcome text. Optionally include a mapsTo column with comma-separated parent ids.
      <a
        href="/guides/outcome-mapper"
        class="font-medium text-primary underline underline-offset-4 hover:text-primary-accent"
      >
        See the reference
      </a>
      for details.
    </Fragment>

    <div class="grid gap-2">
      <Label for="outcome-input">Paste outcome data</Label>
      <Textarea
        id="outcome-input"
        rows="10"
        placeholder={`level,id,text,mapsTo\nprogram,po1,Students communicate effectively,\ncourse,co1,Write clear arguments,po1\nassessment,ao1,Thesis statement is clear,co1`}
      />
      <p class="text-xs text-muted-foreground">Comma-separated or tab-separated values are detected automatically.</p>
    </div>

    <div id="import-warnings" class="grid gap-2"></div>

    <div class="flex flex-wrap items-center gap-2">
      <Button id="parse-outcomes">Load outcomes</Button>
      <Button id="load-sample-outcomes" variant="outline">
        Load sample outcomes
      </Button>
    </div>

    <LocalOnlyNotice slot="footer">
      Pasted content is processed locally — there is no server, no upload, and no tracking.
    </LocalOnlyNotice>
  </ToolStep>

  <!-- Step 2: Map -->
  <ToolStep step={steps[1]} title="Map outcomes">
    <Fragment slot="description">For each lower-level outcome, select the higher-level outcomes it supports.</Fragment>

    <div id="outcome-summary" class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground"></div>
    <div id="outcome-editor" class="grid gap-6"></div>

    <StepNav slot="footer" />
  </ToolStep>

  <!-- Step 3: Export -->
  <ToolStep step={steps[2]} title="Export">
    <Fragment slot="description">Download the alignment table or the updated outcome list.</Fragment>

    <div class="grid gap-4">
      <StatRow items={[{ label: "Alignments:", id: "alignment-count" }]} />
      <CodePreview id="export-preview" />
    </div>

    <StepNav slot="footer">
      <div slot="actions" class="flex flex-wrap gap-2">
        <Button id="copy-export" variant="outline">
          <ClipboardText class="size-4" aria-hidden="true" />
          Copy
        </Button>
        <Button id="download-alignments">
          <Download class="size-4" aria-hidden="true" />
          Download alignments
        </Button>
        <Button id="download-outcomes" variant="outline">
          <Download class="size-4" aria-hidden="true" />
          Download outcomes
        </Button>
      </div>
    </StepNav>
  </ToolStep>

  <script>
    import "@/scripts/tools/outcome-mapper/app";
  </script>
</ToolLayout>
