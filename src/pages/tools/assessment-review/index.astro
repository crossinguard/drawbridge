---
import { getEntry, render } from "astro:content";

import ClipboardText from "@tabler/icons/outline/clipboard-text.svg";
import Download from "@tabler/icons/outline/download.svg";
import FileZip from "@tabler/icons/outline/file-zip.svg";

// The course content is rendered as prose; this pulls in the typography.
import "@/components/starwind/prose/styles.css";

import { Button } from "@/components/starwind/button";
import { Input } from "@/components/starwind/input";
import { Label } from "@/components/starwind/label";
import { NativeSelect, NativeSelectOption } from "@/components/starwind/native-select";

import QuickStartCollapsible from "@/components/drawbridge/QuickStartCollapsible.astro";
import LocalOnlyNotice from "@/components/drawbridge/tools/LocalOnlyNotice.astro";
import StepNav from "@/components/drawbridge/tools/StepNav.astro";
import ToolLayout from "@/components/drawbridge/tools/ToolLayout.astro";
import ToolStep from "@/components/drawbridge/tools/ToolStep.astro";

import { requireToolBySlug } from "@/lib/tools/registry";
import { steps } from "@/lib/tools/assessment-review/steps";

const tool = requireToolBySlug("assessment-review");

const quickStartEntry = await getEntry("guides", "assessment-review-quick-start");
if (!quickStartEntry) throw new Error('Missing guide entry "assessment-review-quick-start".');
const { Content: QuickStartContent } = await render(quickStartEntry);
---

<ToolLayout tool={tool} steps={steps}>
  <QuickStartCollapsible slot="quick-start" toolSlug={tool.slug} description={quickStartEntry.data.description}>
    <QuickStartContent />
  </QuickStartCollapsible>

  <!-- Step 1: Open -->
  <ToolStep step={steps[0]} title="Open a course export" hidden={false} class="gap-6">
    <Fragment slot="description">
      Choose the Canvas course export — the <code>.imscc</code> file from <em>Settings → Export Course Content</em>, or
      the same file renamed to <code>.zip</code>. The file is read in your browser and never uploaded.
    </Fragment>

    <div
      id="drop-zone"
      class="grid gap-4 rounded-lg border-2 border-dashed border-border bg-muted/20 p-6 text-center transition-colors"
    >
      <div class="grid gap-1">
        <p class="text-sm font-medium">Drop the export here</p>
        <p class="text-xs text-muted-foreground">
          A <code>.imscc</code> or <code>.zip</code> archive.
        </p>
      </div>

      <div class="flex flex-wrap justify-center gap-2">
        <Button id="choose-file" variant="outline">
          <FileZip class="size-4" aria-hidden="true" />
          Choose an archive
        </Button>
      </div>

      <input type="file" id="file-input" accept=".imscc,.zip" class="sr-only" />

      <p id="open-status" class="text-xs text-muted-foreground" role="status"></p>
    </div>

    <div id="open-errors" class="grid gap-2"></div>
    <div id="open-warnings" class="grid gap-2"></div>

    <div id="open-summary" class="grid gap-3 rounded-lg border border-border p-4" hidden></div>

    <LocalOnlyNotice slot="footer">
      The export is opened with the browser's own file APIs. There is no server, no upload, and no tracking — closing
      the tab forgets everything.
    </LocalOnlyNotice>
  </ToolStep>

  <!-- Step 2: Review -->
  <ToolStep step={steps[1]} title="Review the assessments" class="gap-4">
    <Fragment slot="description">
      Everything the export says about the course's graded items, with the checks that compare them. Use the tabs to
      move between the views; the filters narrow every list at once.
    </Fragment>

    <div id="review-stats" class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground"></div>

    <details id="review-settings-panel" class="rounded-lg border border-border">
      <summary class="cursor-pointer px-4 py-3 text-sm font-medium">Review settings</summary>
      <div class="border-t border-border px-4 py-4">
        <div id="review-settings" class="grid gap-4"></div>
      </div>
    </details>

    <div id="review-tabs" class="grid gap-4">
      <div class="flex flex-wrap items-end gap-3">
        <div class="grid min-w-56 flex-1 gap-1.5">
          <Label for="search-input">Search</Label>
          <Input id="search-input" type="search" placeholder="Titles, instructions, rubrics…" autocomplete="off" />
        </div>

        <div class="grid gap-1.5">
          <Label for="kind-filter">Type</Label>
          <NativeSelect id="kind-filter">
            <NativeSelectOption value="all">All types</NativeSelectOption>
            <NativeSelectOption value="assignment">Assignments</NativeSelectOption>
            <NativeSelectOption value="quiz">Quizzes</NativeSelectOption>
            <NativeSelectOption value="graded-discussion">Graded discussions</NativeSelectOption>
          </NativeSelect>
        </div>

        <div class="grid gap-1.5">
          <Label for="usage-filter">Usage</Label>
          <NativeSelect id="usage-filter">
            <NativeSelectOption value="all">Everything</NativeSelectOption>
            <NativeSelectOption value="in-use">In use</NativeSelectOption>
            <NativeSelectOption value="probably-legacy">Probably legacy</NativeSelectOption>
            <NativeSelectOption value="unclear">Unclear</NativeSelectOption>
          </NativeSelect>
        </div>

        <div class="grid gap-1.5">
          <Label for="group-filter">Group</Label>
          <NativeSelect id="group-filter">
            <NativeSelectOption value="all">All groups</NativeSelectOption>
          </NativeSelect>
        </div>
      </div>

      <div
        id="review-tabs-list"
        class="flex flex-wrap gap-1 rounded-md border border-border p-0.5"
        role="tablist"
      ></div>

      <div id="review-panel" class="min-h-96 rounded-lg border border-border"></div>
    </div>

    <StepNav slot="footer" nextLabel="Continue to the export" />
  </ToolStep>

  <!-- Step 3: Export -->
  <ToolStep step={steps[2]} title="Export the review" class="gap-4">
    <Fragment slot="description">
      A bundle of files: a short brief that says what the review found, a set of tables an assistant can query, the
      detail of the items that need looking at, and a manifest that lists everything. Nothing leaves your browser.
    </Fragment>

    <div id="export-stats" class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground"></div>

    <details class="rounded-lg border border-border">
      <summary class="cursor-pointer px-4 py-3 text-sm font-medium">Export settings</summary>
      <div class="border-t border-border px-4 py-4">
        <div id="export-settings" class="grid gap-4"></div>
      </div>
    </details>

    <div id="export-preview" class="max-h-128 overflow-auto rounded-lg border border-border"></div>

    <StepNav slot="footer">
      <div slot="actions" class="flex flex-wrap gap-2">
        <Button id="download-bundle" variant="outline">
          <Download class="size-4" aria-hidden="true" />
          Download the bundle (ZIP)
        </Button>
        <Button id="copy-brief" variant="outline">
          <ClipboardText class="size-4" aria-hidden="true" />
          Copy the brief
        </Button>
      </div>
    </StepNav>
  </ToolStep>

  <script>
    import "@/scripts/tools/assessment-review/app";
  </script>
</ToolLayout>
