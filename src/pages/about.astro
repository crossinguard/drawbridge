---
import DrawbridgeLayout from "@/layouts/DrawbridgeLayout.astro";
import supersonic from "@/assets/crossinguard/supersonic.svg";
import PageHeader from "@/components/drawbridge/PageHeader.astro";
import { Prose } from "@/components/starwind/prose";
---

<DrawbridgeLayout title="About" description="About Drawbridge: free, private tools for assessment work.">
  <div class="mx-auto grid max-w-3xl gap-8">
    <PageHeader title="About" description="What Drawbridge is and why it exists." />

    <Prose class="max-w-none text-foreground" style="--sw-prose-h2-size: 1.125rem;">
      <h2>Purpose</h2>
      <p>
        Drawbridge is a collection of small, focused tools for working with course content. It is built around a simple
        idea: useful utilities should not require an account, a subscription, or a network connection.
      </p>

      <h2>Privacy by design</h2>
      <p>
        Every tool processes imported files entirely in your browser. There is no server reading your files, no
        analytics tracking your actions, and no database storing your work. Once the site is loaded, it works offline
        and can be installed as a progressive web app.
      </p>
      <p>
        For sensitive course data, this means you can use Drawbridge without sending information anywhere. Refresh or
        close the tab and the imported course is forgotten.
      </p>

      <h2>Open and free</h2>
      <p>
        Drawbridge is free to use. It is primarily built for personal use, but others are welcome to use it if they find
        it helpful.
      </p>

      <h2>Credits</h2>
      <p>
        Drawbridge is built and maintained by
        <a
          href="https://crossinguard.dev"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="crossinguard.dev (opens in a new tab)"
          class="not-sw-prose inline-flex items-center gap-1.5 font-medium text-primary underline underline-offset-4 hover:text-primary-accent px-2"
        >
          <img src={supersonic.src} alt="" width="16" height="16" aria-hidden="true" />
          crossinguard
        </a>
      </p>
    </Prose>
  </div>
</DrawbridgeLayout>
