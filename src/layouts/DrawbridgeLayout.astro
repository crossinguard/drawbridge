---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { ThemeInitScript } from "@starwind-ui/astro/theme";
import "@/styles/starwind.css";

import Header from "@/components/drawbridge/Header.astro";
import Footer from "@/components/drawbridge/Footer.astro";
import UpdateNotice from "@/components/drawbridge/UpdateNotice.astro";

interface Props {
  title: string;
  description?: string;
  fullWidth?: boolean;
}

const { title, description, fullWidth = false } = Astro.props;
const pageTitle = title === "Drawbridge" ? title : `${title} · Drawbridge`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{pageTitle}</title>
    <meta name="color-scheme" content="light dark" />
    <ThemeInitScript />
    <ClientRouter />
    <Font cssVariable="--font-hyperlegible-next" preload />
    <Font cssVariable="--font-hyperlegible-mono" />
    <Font cssVariable="--font-paintfactory" preload />
    {import.meta.env.PROD && (
      <meta
        http-equiv="Content-Security-Policy"
        content="default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'"
      />
    )}
  </head>

  <body class="min-h-svh flex flex-col">
    <Header />

    <main class={fullWidth ? "flex-1" : "mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:py-12"}>
      <slot />
    </main>

    <Footer />

    <UpdateNotice />
    <script>
      import "@/scripts/lib/pwa";
    </script>
  </body>
</html>
