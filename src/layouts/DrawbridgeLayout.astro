---
import "@/styles/starwind.css";
import { ThemeInitScript } from "@starwind-ui/astro/theme";
import ShieldLock from "@tabler/icons/outline/shield-lock.svg";

import { ThemeToggle } from "@/components/starwind/theme-toggle";
import { Toaster } from "@/components/starwind/toast";

interface Props {
  title: string;
  description?: string;
  fullWidth?: boolean;
}

const { title, description, fullWidth = false } = Astro.props;
const pageTitle = title === "Drawbridge" ? title : `${title} · Drawbridge`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{pageTitle}</title>
    <ThemeInitScript />
    {
      import.meta.env.PROD && (
        <meta
          http-equiv="Content-Security-Policy"
          content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'"
        />
      )
    }
  </head>

  <body class="min-h-svh flex flex-col">
    <header class="border-b bg-background">
      <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-4">
        <a href="/" class="inline-flex items-center gap-2 text-xl font-bold tracking-tight hover:opacity-80">
          <span class="text-primary">Drawbridge</span>
        </a>
        <nav class="flex flex-wrap items-center gap-4 text-sm">
          <a href="/tools" class="text-muted-foreground hover:text-foreground">Tools</a>
          <a href="/guides" class="text-muted-foreground hover:text-foreground">Guides</a>
          <a href="/about" class="text-muted-foreground hover:text-foreground">About</a>
          <a href="/privacy" class="text-muted-foreground hover:text-foreground">Privacy</a>
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main class={fullWidth ? "flex-1" : "mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:py-12"}>
      <slot />
    </main>

    <footer class="border-t bg-background">
      <div class="mx-auto flex w-full max-w-6xl flex-col gap-3 px-4 py-6 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
        <div class="inline-flex items-center gap-2">
          <ShieldLock class="size-4" aria-hidden="true" />
          <span>Nothing leaves your device.</span>
        </div>
        <div class="flex flex-wrap gap-4">
          <a href="/about" class="hover:text-foreground">About</a>
          <a href="/privacy" class="hover:text-foreground">Privacy</a>
          <a href="/tools" class="hover:text-foreground">Tools</a>
        </div>
      </div>
    </footer>

    <Toaster position="bottom-right" />
  </body>
</html>
